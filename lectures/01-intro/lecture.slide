* switch

  switch coinflip() {
  case "heads":
      heads++
  case "tails":
      tails++
  default:
      fmt.Println("landed on edge!")
  }

_tagless_ switch.

  func Signum(x int) int {
      switch {
      case x > 0:
          return +1
      default:
          return 0
      case x < 0:
          return -1
      }
  }

